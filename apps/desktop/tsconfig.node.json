{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    // composite なプロジェクトは宣言ファイルの出力が必須。型検査だけしたいので
    // .d.ts のみを一時ディレクトリに出す（noEmit は composite と併用できない）。
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsconfig.node"
  },
  "include": ["vite.config.ts"]
}
